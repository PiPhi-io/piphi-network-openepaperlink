{
  "schema_version": "1",
  "identity": {"publisher_id": "io.piphi", "package_id": "openepaperlink-ap", "version": "0.1.1"},
  "name": "OpenEPaperLink Access Point",
  "description": "Configured-tag and queued-transfer counts from a local OpenEPaperLink access point.",
  "origin": "integration",
  "owning_integration_id": "piphi-network-openepaperlink",
  "sdk_version_range": ">=0.6.1,<0.7",
  "requires_integrations": [{"integration_id": "piphi-network-openepaperlink", "version_range": ">=0.1,<1", "optional": false}],
  "recommended_for_integrations": ["piphi-network-openepaperlink"],
  "widgets": [{
    "id": "ap-summary",
    "name": "Access Point Summary",
    "description": "Configured tags and pending transfers on one local AP.",
    "runtime": "declarative",
    "presentation": {
      "contract_version": "1", "shell": "core", "content_surface": "transparent", "typography": "core",
      "appearance_controls": ["icon", "title", "surface", "opacity", "radius", "shadow"]
    },
    "interaction_targets": [
      {"id": "card", "label": "OpenEPaperLink access point", "kind": "card", "allowed_actions": ["more-info", "popout", "refresh"], "default_action": "more-info"},
      {"id": "tags", "label": "Configured tags", "kind": "binding", "binding_slot_id": "tags", "allowed_actions": ["more-info", "history", "popout"], "default_action": "more-info"},
      {"id": "pending", "label": "Pending transfers", "kind": "binding", "binding_slot_id": "pending", "allowed_actions": ["more-info", "history", "popout"], "default_action": "more-info"}
    ],
    "binding_slots": [
      {"id": "tags", "label": "Configured tags", "required": true, "binding_modes": ["read"], "capability_requirements": ["ap_tag_count"], "compatible_integration_ids": ["piphi-network-openepaperlink"], "data_delivery": {"mode": "stream_preferred", "stale_after_seconds": 600}},
      {"id": "pending", "label": "Pending transfers", "required": true, "binding_modes": ["read"], "capability_requirements": ["ap_pending_transfer_count"], "compatible_integration_ids": ["piphi-network-openepaperlink"], "data_delivery": {"mode": "stream_preferred", "stale_after_seconds": 600}}
    ],
    "recipe": {
      "schema_version": "1", "layout": "grid", "columns": 2,
      "items": [
        {"type": "metric", "slot_id": "tags", "label": "Tags", "format": "number", "emphasis": "hero", "action": {"type": "details", "label": "View configured tag count"}},
        {"type": "metric", "slot_id": "pending", "label": "Pending", "format": "number", "action": {"type": "details", "label": "View pending transfers"}}
      ]
    },
    "certification": {
      "schema_version": "1",
      "verified_gates": ["runtime", "persistence", "binding", "states", "responsive", "themes", "accessibility", "save-reload", "performance"],
      "evidence": {
        "runtime": ["core-profile:declarative-v2/runtime"],
        "persistence": ["core-profile:declarative-v2/persistence"],
        "binding": ["core-profile:declarative-v2/binding"],
        "states": ["core-profile:declarative-v2/states"],
        "responsive": ["core-profile:declarative-v2/responsive"],
        "themes": ["core-profile:declarative-v2/themes"],
        "accessibility": ["core-profile:declarative-v2/accessibility"],
        "save-reload": ["core-profile:declarative-v2/save-reload"],
        "performance": ["core-profile:declarative-v2/performance"]
      }
    },
    "default_column_span": 3,
    "default_row_span": 2
  }]
}
